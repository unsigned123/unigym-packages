#usda 1.0
(
    defaultPrim = "StaticCup"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "StaticCup"
{
    def Cube "body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 0.1
        bool physics:collisionEnabled = 1
        double3 xformOp:translate = (0, 0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
